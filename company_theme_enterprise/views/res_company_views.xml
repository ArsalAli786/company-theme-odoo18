<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_apps_background" model="ir.ui.view">
        <field name="name">res.company.form.apps.background</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="company_theme.view_res_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_primary_color']" position="after">
                <field name="apps_menu_background" widget="image"/>
            </xpath>
        </field>
    </record>
</odoo>
