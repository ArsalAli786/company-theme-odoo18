<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="company_theme_colors"
              inherit_id="web.webclient_bootstrap"
              name="Company Theme Colors">

        <xpath expr="//t[@t-set='head_web']/meta[@name='theme-color']" position="replace">
            <t t-set="company_id" t-value="(request.cookies.get('cids') or '1').split('-')[0]"/>
            <t t-set="primary_color" t-value="request.env['res.company'].browse(int(company_id)).company_primary_color"/>
            <t t-set="primary_color_is_valid"
               t-value="primary_color and len(primary_color) == 7 and primary_color[0] == '#' and all(character in '0123456789abcdefABCDEF' for character in primary_color[1:])"/>
            <t t-set="primary_color_channels"
               t-value="tuple(int(primary_color[index:index + 2], 16) for index in (1, 3, 5)) if primary_color_is_valid else (0, 0, 0)"/>
            <t t-set="primary_rgb" t-value="'%d, %d, %d' % primary_color_channels"/>
            <t t-set="primary_hover_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.88) for channel in primary_color_channels)"/>
            <t t-set="primary_active_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.78) for channel in primary_color_channels)"/>
            <t t-set="primary_text_emphasis_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.4) for channel in primary_color_channels)"/>
            <t t-set="primary_bg_subtle_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.2 + 255 * 0.8) for channel in primary_color_channels)"/>
            <t t-set="primary_border_subtle_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.4 + 255 * 0.6) for channel in primary_color_channels)"/>
            <t t-set="primary_disabled_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.5 + 255 * 0.5) for channel in primary_color_channels)"/>
            <t t-set="primary_selection_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.2 + base * 0.8) for channel, base in zip(primary_color_channels, (248, 249, 250)))"/>
            <t t-set="primary_highlight_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.1 + 255 * 0.9) for channel in primary_color_channels)"/>
            <t t-set="primary_calendar_highlight_rgb"
               t-value="'%d, %d, %d' % tuple(int(channel * 0.25 + 255 * 0.75) for channel in primary_color_channels)"/>
            <meta name="theme-color" t-att-content="primary_color if primary_color_is_valid else '#71639e'"/>
        </xpath>

        <xpath expr="//t[@t-set='head_web']" position="inside">
            <t t-if="primary_color_is_valid">
                <style>
                    :root {
                        --company-primary: <t t-out="primary_color"/>;
                        --company-primary-rgb: <t t-out="primary_rgb"/>;
                        --company-primary-hover-rgb: <t t-out="primary_hover_rgb"/>;
                        --company-primary-active-rgb: <t t-out="primary_active_rgb"/>;
                        --company-primary-text-emphasis-rgb: <t t-out="primary_text_emphasis_rgb"/>;
                        --company-primary-bg-subtle-rgb: <t t-out="primary_bg_subtle_rgb"/>;
                        --company-primary-border-subtle-rgb: <t t-out="primary_border_subtle_rgb"/>;
                        --company-primary-disabled-rgb: <t t-out="primary_disabled_rgb"/>;
                        --company-primary-selection-rgb: <t t-out="primary_selection_rgb"/>;
                        --company-primary-highlight-rgb: <t t-out="primary_highlight_rgb"/>;
                        --company-primary-calendar-highlight-rgb: <t t-out="primary_calendar_highlight_rgb"/>;

                        --company-primary-hover: rgb(var(--company-primary-hover-rgb));
                        --company-primary-active: rgb(var(--company-primary-active-rgb));
                        --company-primary-disabled: rgb(var(--company-primary-disabled-rgb));
                        --company-primary-selection: rgb(var(--company-primary-selection-rgb));
                        --company-primary-highlight: rgb(var(--company-primary-highlight-rgb));
                        --company-primary-calendar-highlight: rgb(var(--company-primary-calendar-highlight-rgb));

                        /* Bootstrap compiles these Sass colors into runtime CSS tokens. */
                        --primary: var(--company-primary);
                        --primary-rgb: var(--company-primary-rgb);
                        --primary-text-emphasis: rgb(var(--company-primary-text-emphasis-rgb));
                        --primary-bg-subtle: rgb(var(--company-primary-bg-subtle-rgb));
                        --primary-border-subtle: rgb(var(--company-primary-border-subtle-rgb));
                        --link-color: var(--company-primary);
                        --link-color-rgb: var(--company-primary-rgb);
                        --link-hover-color: var(--company-primary-hover);
                        --link-hover-color-rgb: var(--company-primary-hover-rgb);
                        --focus-ring-color: rgba(var(--company-primary-rgb), 0.25);
                        --o-stat-text-color: var(--company-primary);
                        --o-stat-button-color: var(--company-primary);
                    }

                    /* Odoo's Apps cards and loading indicator use fixed Sass colors. */
                    .o_modules_kanban code {
                        color: var(--company-primary);
                    }

                    .o_loading_indicator {
                        background-color: var(--company-primary);
                    }

                    /* Odoo emits these fixed Sass utilities with !important, so the theme must match it. */
                    .text-primary,
                    .text-action {
                        color: rgba(var(--company-primary-rgb), var(--text-opacity, 1)) !important;
                    }

                    a.text-primary:hover,
                    a.text-primary:focus,
                    a.text-primary:active,
                    a.text-primary.active,
                    button.text-primary:hover,
                    button.text-primary:focus,
                    button.text-primary:active,
                    button.text-primary.active,
                    .btn-link.text-primary:hover,
                    .btn-link.text-primary:focus,
                    .btn-link.text-primary:active,
                    .btn-link.text-primary.active,
                    a.text-action:hover,
                    a.text-action:focus,
                    a.text-action:active,
                    a.text-action.active,
                    button.text-action:hover,
                    button.text-action:focus,
                    button.text-action:active,
                    button.text-action.active,
                    .btn-link.text-action:hover,
                    .btn-link.text-action:focus,
                    .btn-link.text-action:active,
                    .btn-link.text-action.active {
                        color: rgba(var(--company-primary-hover-rgb), var(--text-opacity, 1)) !important;
                    }

                    .bg-primary,
                    .text-bg-primary,
                    .bg-action,
                    .text-bg-action {
                        --background-color: rgba(var(--company-primary-rgb), var(--bg-opacity, 1));
                        background-color: rgba(var(--company-primary-rgb), var(--bg-opacity, 1)) !important;
                    }

                    .btn-primary,
                    .btn-fill-primary {
                        --btn-bg: var(--company-primary);
                        --btn-color: #ffffff;
                        --btn-border-color: var(--company-primary);
                        --btn-hover-bg: var(--company-primary-hover);
                        --btn-hover-border-color: var(--company-primary-hover);
                        --btn-hover-color: #ffffff;
                        --btn-active-bg: var(--company-primary-active);
                        --btn-active-border-color: var(--company-primary-active);
                        --btn-active-color: #ffffff;
                        --btn-disabled-bg: var(--company-primary-disabled);
                        --btn-disabled-border-color: var(--company-primary-disabled);
                        --btn-focus-shadow-rgb: var(--company-primary-rgb);
                    }

                    .btn-outline-primary {
                        --btn-color: var(--company-primary);
                        --btn-border-color: var(--company-primary);
                        --btn-bg: transparent;
                        --btn-hover-bg: var(--company-primary);
                        --btn-hover-border-color: var(--company-primary);
                        --btn-hover-color: #ffffff;
                        --btn-active-bg: var(--company-primary-active);
                        --btn-active-border-color: var(--company-primary-active);
                        --btn-active-color: #ffffff;
                        --btn-focus-shadow-rgb: var(--company-primary-rgb);
                    }

                    .o_main_navbar {
                        background: var(--company-primary);
                        --NavBar-entry-backgroundColor: var(--company-primary);
                        --NavBar-entry-backgroundColor--hover: var(--company-primary-hover);
                        --NavBar-entry-backgroundColor--active: var(--company-primary-active);
                    }

                    .nav-pills {
                        --nav-pills-link-active-bg: var(--company-primary);
                    }

                    .pagination {
                        --pagination-active-bg: var(--company-primary);
                        --pagination-active-border-color: var(--company-primary);
                        --pagination-focus-box-shadow: 0 0 0 0.25rem rgba(var(--company-primary-rgb), 0.25);
                    }

                    .nav-link:focus-visible {
                        box-shadow: 0 0 0 0.25rem rgba(var(--company-primary-rgb), 0.25);
                    }

                    .form-control:focus:not(.is-invalid),
                    .form-select:focus:not(.is-invalid) {
                        border-color: var(--company-primary);
                        box-shadow: 0 0 0 0.25rem rgba(var(--company-primary-rgb), 0.25);
                    }

                    .form-check-input:focus:not(.is-invalid) {
                        border-color: var(--company-primary);
                        box-shadow: 0 0 0 0.25rem rgba(var(--company-primary-rgb), 0.25);
                    }

                    .form-check-input:checked:not(.is-invalid),
                    .form-check-input[type="checkbox"]:indeterminate:not(.is-invalid) {
                        background-color: var(--company-primary);
                        border-color: var(--company-primary);
                    }

                    .form-range::-webkit-slider-thumb,
                    .form-range::-moz-range-thumb {
                        background-color: var(--company-primary);
                    }

                    .form-range::-webkit-slider-thumb:active,
                    .form-range::-moz-range-thumb:active {
                        background-color: var(--company-primary-active);
                    }

                    .form-range:focus::-webkit-slider-thumb,
                    .form-range:focus::-moz-range-thumb {
                        box-shadow: 0 0 0 1px var(--body-bg), 0 0 0 0.25rem rgba(var(--company-primary-rgb), 0.25);
                    }

                    .o_field_widget:focus-within {
                        --o-input-border-color: var(--company-primary);
                        --o-caret-color: var(--company-primary);
                    }

                    .o_field_properties :is(.o_input:focus, .dropdown:focus ~ .o_dropdown_button, .dropdown:focus-within ~ .o_dropdown_button, .o_input:focus ~ .o_datepicker_button, .o_dropdown_button:focus),
                    .o_property_field_popover :is(.o_input:focus, .dropdown:focus ~ .o_dropdown_button, .dropdown:focus-within ~ .o_dropdown_button, .o_input:focus ~ .o_datepicker_button, .o_dropdown_button:focus) {
                        --o-input-border-color: var(--company-primary);
                    }

                    .o_searchview:focus-within,
                    .o_searchview:focus-within + .o_searchview_dropdown_toggler {
                        border-color: var(--company-primary);
                    }

                    .o_form_view .o_form_uri,
                    .o_form_view .o_form_uri > span:first-child {
                        color: var(--company-primary);
                    }

                    .o_form_view .o_form_uri:hover,
                    .o_form_view .o_form_uri:focus,
                    .o_form_view .o_form_uri:hover > span:first-child,
                    .o_form_view .o_form_uri:focus > span:first-child,
                    .o_form_view .o_form_uri > span:first-child:hover,
                    .o_form_view .o_form_uri > span:first-child:focus {
                        color: var(--company-primary-hover);
                    }

                    .o_pivot table.o_enable_linking .o_pivot_cell_value:not(.o_empty):hover,
                    .o_pivot table.o_enable_linking .o_pivot_cell_value:not(.o_empty):focus,
                    .o_pivot table.o_enable_linking .o_pivot_cell_value:not(.o_empty).focus {
                        color: var(--company-primary-hover);
                    }

                    .o_form_view.o_onboarding_payment_provider_wizard .o_form_renderer a[type="action"] {
                        color: var(--company-primary);
                    }

                    .o_form_view.o_onboarding_payment_provider_wizard .o_form_renderer a[type="action"]:hover,
                    .o_form_view.o_onboarding_payment_provider_wizard .o_form_renderer a[type="action"]:focus,
                    .o_form_view.o_onboarding_payment_provider_wizard .o_form_renderer a[type="action"]:active {
                        color: var(--company-primary-hover);
                    }

                    .o_list_view .o_list_renderer .o_field_x2many_list_row_add a:focus,
                    .o_list_view .o_list_renderer .o_field_x2many_list_row_add a:active,
                    .o_list_view .o_list_renderer .o_field_x2many_list_row_add button:focus,
                    .o_list_view .o_list_renderer .o_field_x2many_list_row_add button:active,
                    .o_list_view .o_list_renderer .o_group_field_row_add a:focus,
                    .o_list_view .o_list_renderer .o_group_field_row_add a:active,
                    .o_list_view .o_list_renderer .o_group_field_row_add button:focus,
                    .o_list_view .o_list_renderer .o_group_field_row_add button:active {
                        color: var(--company-primary-hover);
                    }

                    :not(.dropstart) > .dropdown-item.active:not(.disabled):not(.dropdown-item_active_noarrow)::before,
                    :not(.dropstart) > .dropdown-item.selected:not(.disabled):not(.dropdown-item_active_noarrow)::before,
                    .o-dropdown.dropstart > .dropdown-item.dropdown-toggle.active:not(.disabled):not(.dropdown-item_active_noarrow)::after,
                    .o-dropdown.dropstart > .dropdown-item.dropdown-toggle.selected:not(.disabled):not(.dropdown-item_active_noarrow)::after {
                        color: var(--company-primary);
                    }

                    .ui-autocomplete .ui-menu-item.o_m2o_dropdown_option > a {
                        color: var(--company-primary);
                    }

                    .ui-autocomplete .ui-menu-item.o_m2o_dropdown_option > a.ui-state-active {
                        color: var(--company-primary-hover);
                    }

                    .badge.text-bg-default,
                    .badge.bg-light,
                    .badge.text-bg-light,
                    .badge.bg-default,
                    .badge.text-primary {
                        outline-color: var(--company-primary);
                    }

                    .o_notebook,
                    .o_kanban_examples_dialog .o_notebook {
                        --notebook-link-border-color-active-accent: var(--company-primary);
                    }

                    .o_kanban_examples_dialog .o_notebook .nav-link.active {
                        background-color: var(--company-primary);
                    }

                    .o_base_settings_view .o_form_renderer {
                        --settings__tab-bg--active: var(--company-primary-selection);
                    }

                    .o_base_settings_view .o_form_renderer .o_setting_container .settings_tab .selected {
                        box-shadow: inset 2px 0 0 var(--company-primary);
                    }

                    body.o_web_client .o_base_settings_view .o_form_renderer .o_setting_container .settings_tab .tab::after {
                        background: var(--company-primary);
                    }

                    .o_kanban_renderer {
                        --KanbanColumn__highlight-background: var(--company-primary-highlight);
                        --KanbanColumn__highlight-border: var(--company-primary);
                    }

                    .o_searchable_setting {
                        --SearchableSetting__highlight-background: var(--company-primary-highlight);
                        --SearchableSetting__highlight-border: var(--company-primary);
                    }

                    .o_command_palette .o_command.focused {
                        background: rgba(var(--company-primary-selection-rgb), 0.65);
                    }

                    .o_field_percent_pie .o_pie {
                        --PercentPieField-color-active: var(--company-primary);
                    }

                    .o_home_menu .o_app.o_focused {
                        background: var(--company-primary-selection);
                        outline-color: var(--company-primary);
                    }

                    .o_datetime_picker .o_selected:not(.o_select_start):not(.o_select_end),
                    .o_datetime_picker .o_date_item_picker .o_datetime_button.o_selected:not(.o_select_start):not(.o_select_end),
                    .o_datetime_picker .o_date_item_picker .o_datetime_button:hover:not(.o_select_start):not(.o_select_end) {
                        background: var(--company-primary-selection);
                    }

                    .o_datetime_picker .o_current::before,
                    .o_datetime_picker .o_highlighted::before,
                    .o_datetime_picker .o_select_start::before,
                    .o_datetime_picker .o_select_end::before {
                        box-shadow: inset 0 0 0 1px var(--company-primary);
                    }

                    .o_datetime_picker .o_select_start::before,
                    .o_datetime_picker .o_select_end::before {
                        background-color: var(--company-primary-calendar-highlight);
                    }

                    .o_datetime_picker .o_select_start:not(.o_select_end)::after,
                    .o_datetime_picker .o_select_end:not(.o_select_start)::after {
                        background: var(--company-primary-selection);
                    }

                    .o_property_field_highlight,
                    .o_property_field_highlight .o_field_property_empty_label {
                        border-color: var(--company-primary);
                    }

                    .o_field_properties div:not([columns="1"]) .o_property_drag_group {
                        background-color: var(--company-primary-highlight);
                        border-color: var(--company-primary);
                    }

                    .o_field_many2one_avatar img:hover {
                        outline-color: var(--company-primary);
                    }

                    .o-EmojiPicker {
                        --EmojiPicker-active: rgba(var(--company-primary-rgb), 0.15);
                    }

                    .o-EmojiPicker.o_switch_toggle .form-check-input,
                    .o-EmojiPicker.o_switch_toggle .form-check-input:checked,
                    .o-EmojiPicker.o_switch_toggle .form-check-input:focus,
                    .o-EmojiPicker.o_switch_toggle:hover .form-check-input:not(:disabled) {
                        border-color: var(--company-primary);
                    }

                    .o-EmojiPicker.o_switch_toggle .form-check-input,
                    .o-EmojiPicker.o_switch_toggle .form-check-input:focus,
                    .o-EmojiPicker.o_switch_toggle .form-check-input:checked {
                        background-image: radial-gradient(circle, var(--company-primary) 0 3px, transparent 3px);
                    }

                    .o_calendar_renderer .fc-event.fc-event-mirror,
                    .o_calendar_renderer .fc-event.fc-dragging {
                        border-color: rgba(var(--company-primary-rgb), 0.5);
                    }

                    .o_calendar_renderer .fc-event.fc-event-mirror .fc-bg,
                    .o_calendar_renderer .fc-event.fc-dragging .fc-bg {
                        background-color: rgba(var(--company-primary-rgb), var(--o-bg-opacity));
                    }

                    .o_calendar_renderer .fc-event.fc-event-mirror {
                        background-color: rgba(var(--company-primary-rgb), var(--o-bg-opacity));
                    }

                    .o_calendar_renderer .fc-daygrid-day-bottom .fc-more-link {
                        color: var(--company-primary);
                    }

                    .o_calendar_renderer .fc-daygrid-day-bottom .fc-more-link:hover {
                        color: var(--company-primary-hover);
                    }

                    .o_calendar_renderer .fc-dayGridYear-view:not(.fc-readonly-year-view) .fc-daygrid-body tr .fc-day .fc-daygrid-day-top:hover > .fc-daygrid-day-number {
                        --o-cw-bg: var(--company-primary-calendar-highlight);
                        --o-cw-color: rgb(var(--company-primary-text-emphasis-rgb));
                    }

                    .o-file-upload-progress-bar-value {
                        background-color: var(--company-primary);
                        border-right-color: var(--company-primary-hover);
                    }

                    .o_field_widget.o_field_image .o_form_image_controls,
                    .o_field_widget.o_field_image_url .o_form_image_controls,
                    .o_field_widget.o_field_image .o_form_image_controls > .fa.o_select_file_button,
                    .o_field_widget.o_field_image_url .o_form_image_controls > .fa.o_select_file_button {
                        background-color: var(--company-primary);
                    }

                    .o_field_widget.o_field_copy {
                        border-color: var(--company-primary);
                        color: var(--company-primary);
                    }

                    .o_barcode {
                        background-color: var(--company-primary);
                    }

                    body.o_web_client .o_mobile_search .o_mobile_search_header {
                        background-color: var(--company-primary);
                    }

                    body.o_web_client .o_mobile_search .o_mobile_search_header .o_mobile_search_button:active {
                        background-color: var(--company-primary-hover);
                    }
                </style>
            </t>
        </xpath>
    </template>
</odoo>
